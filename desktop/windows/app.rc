#include <windows.h>

101 ICON "@CMAKE_CURRENT_BINARY_DIR@/app.ico"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "GitHub Team App"
   VALUE "ProductName", "GitHub Team App"
   VALUE "FileVersion", "1.0.0"
   VALUE "ProductVersion", "1.0.0"
   VALUE "OriginalFilename", "GitHub Team App.exe"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
